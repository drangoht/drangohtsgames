# Copier en `.env` sur le serveur, puis renseigner. Ne jamais versionner `.env`.

# Clé d'API itch.io (scope profile:games) — https://itch.io/user/settings/api-keys
ITCHIO_API_KEY=

# Image publiée par la CI. IMAGE_TAG est écrasé à chaque déploiement par le SHA du commit ;
# le renseigner à la main permet de revenir à une version précise.
IMAGE=ghcr.io/drangoht/drangohtgames
IMAGE_TAG=latest

# Port exposé sur l'hôte, à placer derrière le reverse proxy.
HTTP_PORT=8080

# Identité du site
SITE_NAME=Drangoht Games
SITE_ITCH_URL=https://drangoht.itch.io/
SITE_CONTACT_EMAIL=
SITE_GITHUB_URL=https://github.com/drangoht

# Devise dans laquelle itch.io libelle les prix plancher du compte
ITCHIO_CURRENCY=USD
ITCHIO_CACHE_DURATION=00:30:00
