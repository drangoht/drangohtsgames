# Ce modèle sert à lancer le site EN LOCAL avec `docker compose up`.
#
# En production, ce fichier n'est PAS à créer à la main : le workflow de déploiement
# le génère sur le serveur à partir des secrets et variables du dépôt GitHub.
# Un fichier écrit à la main ici serait écrasé au prochain déploiement.
#
# Ne jamais versionner votre propre `.env` — il est dans .gitignore.

# Clé d'API itch.io (scope profile:games) — https://itch.io/user/settings/api-keys
ITCHIO_API_KEY=

# Image publiée par la CI. En production, IMAGE_TAG porte le SHA court du commit déployé.
IMAGE=ghcr.io/drangoht/drangohtsgames
IMAGE_TAG=latest

# Port exposé sur l'hôte, à placer derrière le reverse proxy.
HTTP_PORT=8080

# Identité du site
SITE_NAME=Drangoht Games
SITE_ITCH_URL=https://drangoht.itch.io/
SITE_CONTACT_EMAIL=
SITE_GITHUB_URL=https://github.com/drangoht

# Devise dans laquelle itch.io libelle les prix plancher du compte
ITCHIO_CURRENCY=USD
ITCHIO_CACHE_DURATION=00:30:00
