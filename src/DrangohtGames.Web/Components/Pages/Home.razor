@page "/"
@using Microsoft.AspNetCore.WebUtilities
@inject IGameCatalog Catalog
@inject IStringLocalizer<SharedResources> T
@inject IOptions<SiteOptions> Site

<PageTitle>@Site.Value.Name</PageTitle>
<SeoHead CanonicalPath="/"
         Title="@Site.Value.Name"
         Description="@T["Home.Intro"]"
         ImageUrl="@ShowcaseImage" />

<h1 class="page-title">@T["Home.Title"]</h1>
<p class="page-intro">@T["Home.Intro"]</p>

@if (_allGames.Count == 0)
{
    <p class="notice notice--warning" role="status">@T["Home.Unavailable"]</p>
}
else
{
    @* La vitrine ne s'affiche pas sous filtre : elle doublonnerait les résultats. *@
    @if (Hero is { } hero)
    {
        <article class="hero">
            <div class="hero__art">
                @if (hero.ShowcaseImageUrl is { } image)
                {
                    <img src="@image" alt="" fetchpriority="high" decoding="async" />
                }
            </div>
            <div class="hero__body">
                <p class="hero__eyebrow">
                    @(hero.IsSelfHosted ? T["Home.PlayableHere"] : T["Home.Featured"])
                </p>
                <h2 class="hero__title">@hero.Title</h2>
                @if (hero.Tagline.For(CultureInfo.CurrentUICulture) is { } tagline)
                {
                    <p class="hero__tagline">@tagline</p>
                }
                <div class="hero__actions">
                    @if (hero.IsSelfHosted)
                    {
                        <a class="button button--primary" href="games/@hero.Slug.Value/play">
                            @T["Game.PlayInBrowser"]
                        </a>
                    }
                    <a class="button button--ghost" href="games/@hero.Slug.Value">@T["Home.SeeGame"]</a>
                </div>
            </div>
        </article>
    }

    @* Les critères sont des liens : une sélection produit une URL partageable et le tri
       fonctionne sans JavaScript — condition d'un rendu serveur statique. *@
    <section class="filters" aria-label="@T["Filter.Legend"]">
        <ul class="chips">
            <li>
                <a class="chip @(_filter.IsActive ? null : "chip--on")" href=".">@T["Filter.All"]</a>
            </li>
            <li>
                <a class="chip @(PlayableOnly ? "chip--on" : null)" href="@HrefTogglingPlayable()">
                    @T["Filter.PlayableHere"]
                </a>
            </li>
            @foreach (var tag in _availableTags)
            {
                <li>
                    <a class="chip @(IsSelected(Tag, tag) ? "chip--on" : null)"
                       href="@HrefWithTag(IsSelected(Tag, tag) ? null : tag)">@tag</a>
                </li>
            }
            @foreach (var engine in _availableEngines)
            {
                <li>
                    <a class="chip chip--engine @(IsSelected(Engine, engine) ? "chip--on" : null)"
                       href="@HrefWithEngine(IsSelected(Engine, engine) ? null : engine)">@engine</a>
                </li>
            }
        </ul>

        @* Recherche et plateforme demandent une saisie : elles restent un formulaire GET.
           Les critères déjà posés voyagent en champs cachés pour ne pas être perdus. *@
        <form method="get" class="filters__form" role="search">
            <input type="hidden" name="tag" value="@Tag" />
            <input type="hidden" name="engine" value="@Engine" />
            @if (PlayableOnly)
            {
                <input type="hidden" name="playable" value="true" />
            }

            <div class="filters__field filters__field--grow">
                <label for="q">@T["Filter.Search"]</label>
                <input type="search" id="q" name="q" value="@Search"
                       placeholder="@T["Filter.SearchPlaceholder"]" autocomplete="off" />
            </div>

            <div class="filters__field">
                <label for="platform">@T["Filter.Platform"]</label>
                <select id="platform" name="platform">
                    <option value="">@T["Filter.Any"]</option>
                    @foreach (var (value, key) in PlatformChoices)
                    {
                        <option value="@value" selected="@IsSelected(Platform, value)">@T[key]</option>
                    }
                </select>
            </div>

            <div class="filters__actions">
                <button type="submit" class="button button--primary">@T["Filter.Apply"]</button>
            </div>
        </form>
    </section>

    <p class="results-count" role="status">
        @(_visibleGames.Count == 1 ? T["Home.GameCountOne"].Value : string.Format(CultureInfo.CurrentCulture, T["Home.GameCount"].Value, _visibleGames.Count))
    </p>

    @if (_visibleGames.Count == 0)
    {
        <p class="notice">@T["Home.EmptyFiltered"]</p>
    }
    else
    {
        <ul class="grid">
            @foreach (var game in Listed)
            {
                <li class="grid__item">
                    <GameCard Game="game" />
                </li>
            }
        </ul>
    }
}

@code {
    private static readonly (string Value, string ResourceKey)[] PlatformChoices =
    [
        (nameof(GamePlatforms.Windows), "Platform.Windows"),
        (nameof(GamePlatforms.Linux), "Platform.Linux"),
        (nameof(GamePlatforms.MacOs), "Platform.MacOs"),
        (nameof(GamePlatforms.Android), "Platform.Android"),
    ];

    private IReadOnlyList<Game> _allGames = [];
    private IReadOnlyList<Game> _visibleGames = [];
    private IReadOnlyList<string> _availableTags = [];
    private IReadOnlyList<string> _availableEngines = [];
    private GameFilter _filter = GameFilter.Empty;

    /// <summary>Contexte de la requête en cours, fourni par le rendu serveur statique.</summary>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "tag")]
    private string? Tag { get; set; }

    [SupplyParameterFromQuery(Name = "engine")]
    private string? Engine { get; set; }

    [SupplyParameterFromQuery(Name = "platform")]
    private string? Platform { get; set; }

    [SupplyParameterFromQuery(Name = "playable")]
    private string? Playable { get; set; }

    private bool PlayableOnly => bool.TryParse(Playable, out var playable) && playable;

    /// <summary>Jeu de la vitrine, absent dès qu'un critère est posé.</summary>
    private Game? Hero => _filter.IsActive ? null : FeaturedGame.Of(_allGames);

    /// <summary>
    /// Illustration de l'aperçu de partage : celle du jeu en vitrine, y compris sous
    /// filtre, puisque l'adresse canonique de la page reste l'accueil nu.
    /// </summary>
    private Uri? ShowcaseImage => FeaturedGame.Of(_allGames)?.ShowcaseImageUrl;

    /// <summary>Jeux de la grille : le jeu en vitrine n'y est pas répété.</summary>
    private IEnumerable<Game> Listed =>
        Hero is { } hero ? _visibleGames.Where(game => game != hero) : _visibleGames;

    protected override async Task OnParametersSetAsync()
    {
        _allGames = await Catalog.GetGamesAsync(HttpContext?.RequestAborted ?? CancellationToken.None);
        _availableTags = GameFilter.AvailableTagsOf(_allGames);
        _availableEngines = GameFilter.AvailableEnginesOf(_allGames);

        _filter = new GameFilter
        {
            SearchTerm = Search,
            Tag = Tag,
            Engine = Engine,
            Platform = ParsePlatform(Platform),
            PlayableHere = PlayableOnly,
        };

        _visibleGames = _filter.Apply(_allGames);
    }

    private string HrefWithTag(string? tag) => Href(tag, Engine, PlayableOnly);

    private string HrefWithEngine(string? engine) => Href(Tag, engine, PlayableOnly);

    private string HrefTogglingPlayable() => Href(Tag, Engine, !PlayableOnly);

    /// <summary>
    /// Compose l'URL de la page en remplaçant un seul critère : cliquer sur un tag ne doit
    /// pas effacer la recherche ni la plateforme déjà choisies.
    /// </summary>
    private string Href(string? tag, string? engine, bool playable)
    {
        var query = new Dictionary<string, string?>(StringComparer.Ordinal);

        AddIfSet(query, "q", Search);
        AddIfSet(query, "tag", tag);
        AddIfSet(query, "engine", engine);
        AddIfSet(query, "platform", Platform);

        if (playable)
        {
            query["playable"] = "true";
        }

        return QueryHelpers.AddQueryString(".", query);
    }

    private static void AddIfSet(Dictionary<string, string?> query, string name, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            query[name] = value;
        }
    }

    /// <summary>
    /// Une plateforme inconnue dans l'URL est ignorée plutôt que de faire échouer la page :
    /// le paramètre vient du visiteur, pas de nous.
    /// </summary>
    private static GamePlatforms? ParsePlatform(string? value) =>
        Enum.TryParse<GamePlatforms>(value, ignoreCase: true, out var platform)
        && platform != GamePlatforms.None
            ? platform
            : null;

    private static bool IsSelected(string? current, string candidate) =>
        string.Equals(current, candidate, StringComparison.OrdinalIgnoreCase);
}
