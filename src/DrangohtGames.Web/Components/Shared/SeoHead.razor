@inject NavigationManager Navigation
@inject IOptions<SiteOptions> Site

@* Ce que la page dit d'elle-même aux moteurs de recherche et aux aperçus de partage.
   Tout passe par ici, et pas seulement pour éviter d'oublier une balise : plusieurs
   <HeadContent> sur une même page ne s'additionnent pas, le dernier rendu efface les
   précédents. Une page qui porte ce composant ne doit donc pas en déclarer un second. *@
<HeadContent>
    @* Une page indexable désigne son adresse de référence : les filtres de l'accueil et
       les paramètres de campagne produisent sinon autant de copies indexées. *@
    <link rel="canonical" href="@CanonicalUrl" />

    <meta name="description" content="@Description" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@Site.Value.Name" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />

    @if (ImageUrl is not null)
    {
        <meta property="og:image" content="@ImageUrl" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    else
    {
        @* Sans illustration, la grande carte afficherait un cadre vide. *@
        <meta name="twitter:card" content="summary" />
    }

    @if (StructuredData is not null)
    {
        @* Le document est produit par un sérialiseur JSON, qui échappe « < » et « > » :
           un titre venu d'itch.io ne peut pas refermer la balise. *@
        <script type="application/ld+json">@((MarkupString)StructuredData)</script>
    }
</HeadContent>

@code {
    /// <summary>Chemin de référence de la page, racine du site comprise.</summary>
    [Parameter, EditorRequired]
    public required string CanonicalPath { get; set; }

    /// <summary>Titre de la page dans un aperçu de partage.</summary>
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    /// <summary>Résumé de la page, repris en méta-description et dans l'aperçu.</summary>
    [Parameter, EditorRequired]
    public required string Description { get; set; }

    /// <summary>Illustration de l'aperçu, absente si la page n'en a pas.</summary>
    [Parameter]
    public Uri? ImageUrl { get; set; }

    /// <summary>Document JSON-LD décrivant la page, quand elle a de quoi en produire un.</summary>
    [Parameter]
    public string? StructuredData { get; set; }

    /// <summary>
    /// Adresse absolue de la page, construite depuis l'hôte réellement demandé.
    /// </summary>
    private string CanonicalUrl =>
        new Uri(new Uri(Navigation.BaseUri), CanonicalPath.TrimStart('/')).ToString();
}
